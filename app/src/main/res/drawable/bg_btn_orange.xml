<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFE65100" android:endColor="#FFE65100" android:type="linear"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFE65100" android:endColor="#FFFF9800" android:type="linear"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>

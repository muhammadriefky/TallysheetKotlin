<?xml version="1.0" encoding="utf-8"?>
<!-- Feature Icon Background - Tracking (Orange Gradient) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Circle Background with Gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF7043"
                android:endColor="#E64A19"
                android:angle="135"
                android:type="linear"/>
        </shape>
    </item>
    
    <!-- Tracking Icon -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            
            <!-- Location Pin -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13C19,5.13 15.87,2 12,2zM12,11.5c-1.38,0 -2.5,-1.12 -2.5,-2.5s1.12,-2.5 2.5,-2.5s2.5,1.12 2.5,2.5S13.38,11.5 12,11.5z"/>
            
            <!-- GPS Rings -->
            <path
                android:strokeColor="#FFC107"
                android:strokeWidth="1.5"
                android:fillColor="#00000000"
                android:pathData="M12,9m-4,0a4,4 0,1,1 8,0a4,4 0,1,1 -8,0"/>
            
            <path
                android:strokeColor="#FFC107"
                android:strokeWidth="1"
                android:fillColor="#00000000"
                android:pathData="M12,9m-6,0a6,6 0,1,1 12,0a6,6 0,1,1 -12,0"
                android:strokeAlpha="0.5"/>
            
        </vector>
    </item>
    
</layer-list>

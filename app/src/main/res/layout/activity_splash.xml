<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Animated Background Particles -->
    <View
        android:id="@+id/particleView1"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_particle_circle"
        android:alpha="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="-40dp"
        android:layout_marginStart="-40dp"/>

    <View
        android:id="@+id/particleView2"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_particle_circle"
        android:alpha="0.08"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-60dp"
        android:layout_marginEnd="-60dp"/>

    <View
        android:id="@+id/particleView3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_particle_circle"
        android:alpha="0.12"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="-20dp"/>

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/containerMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="80dp">

        <!-- Animated Logo Container -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center">

            <!-- Outer Ring Animation -->
            <View
                android:id="@+id/ringOuter"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_ring_outer"
                android:alpha="0.3"/>

            <!-- Middle Ring Animation -->
            <View
                android:id="@+id/ringMiddle"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ring_middle"
                android:alpha="0.5"/>

            <!-- Inner Circle with Icon -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                app:cardCornerRadius="50dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_logo_gradient"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_warehouse_splash"
                        android:contentDescription="@string/app_name"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- App Name with Animated Reveal -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TALLYSHEET"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="32dp"
            android:alpha="0"/>

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GUDANG"
            android:textSize="18sp"
            android:textColor="@color/accent"
            android:letterSpacing="0.5"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="4dp"
            android:alpha="0"/>

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Warehouse Management System"
            android:textSize="14sp"
            android:textColor="#B3FFFFFF"
            android:fontFamily="sans-serif"
            android:layout_marginTop="16dp"
            android:alpha="0"/>

    </LinearLayout>

    <!-- Feature Highlights (Animated Cards) -->
    <LinearLayout
        android:id="@+id/containerFeatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@id/containerBottom"
        android:layout_marginBottom="40dp"
        android:alpha="0">

        <!-- Feature 1: Scan -->
        <LinearLayout
            android:id="@+id/featureScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#26FFFFFF">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_scan"
                    app:tint="@color/white"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast Scan"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Feature 2: Real-time -->
        <LinearLayout
            android:id="@+id/featureRealtime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#26FFFFFF">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sync_splash"
                    app:tint="@color/white"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Feature 3: Tracking -->
        <LinearLayout
            android:id="@+id/featureTracking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#26FFFFFF">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_inventory"
                    app:tint="@color/white"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tracking"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Section: Loading & Version -->
    <LinearLayout
        android:id="@+id/containerBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Custom Loading Indicator -->
        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:alpha="0">

            <View
                android:id="@+id/loadingDot1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_loading_dot"
                android:layout_marginHorizontal="4dp"/>

            <View
                android:id="@+id/loadingDot2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_loading_dot"
                android:layout_marginHorizontal="4dp"/>

            <View
                android:id="@+id/loadingDot3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_loading_dot"
                android:layout_marginHorizontal="4dp"/>
        </LinearLayout>

        <!-- Loading Text -->
        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mempersiapkan sistem..."
            android:textSize="14sp"
            android:textColor="#80FFFFFF"
            android:layout_marginTop="16dp"
            android:alpha="0"/>

        <!-- Version -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textSize="12sp"
            android:textColor="#4DFFFFFF"
            android:layout_marginTop="24dp"
            android:alpha="0"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
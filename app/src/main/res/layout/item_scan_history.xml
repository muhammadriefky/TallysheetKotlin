<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/surface_variant"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Table Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- SKU & Product Name Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2.5"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    tools:text="SKU-12345" />

                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:layout_marginTop="2dp"
                    tools:text="Indomie Goreng Spesial 85gr" />
            </LinearLayout>

            <!-- Karton Column -->
            <TextView
                android:id="@+id/tvQtyKarton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                tools:text="10" />

            <!-- PCS Column -->
            <TextView
                android:id="@+id/tvQtyPcs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                tools:text="50" />

            <!-- ★ Total PCS Column (Hasil Konversi) -->
            <TextView
                android:id="@+id/tvTotalPcs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:gravity="center"
                tools:text="1250" />
        </LinearLayout>

        <!-- Time Row with Conversion Info & Scanned By -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                tools:text="10:35:12" />

            <!-- ★ Conversion Info -->
            <TextView
                android:id="@+id/tvConversion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="@color/text_hint"
                android:layout_marginEnd="8dp"
                tools:text="1 Krt = 24 PCS" />

            <!-- ★ Scanned By Info -->
            <TextView
                android:id="@+id/tvScannedBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="@color/text_hint"
                android:textStyle="italic"
                tools:text="📱 John Doe" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
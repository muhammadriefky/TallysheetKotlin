<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_password_requirements.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:elevation="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header_blue"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_circle_white"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔐"
                android:textSize="30sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Format Password Tidak Valid"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="VALIDASI PASSWORD"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password harus memenuhi semua ketentuan berikut:"
            android:textColor="@color/dlg_text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="16dp" />

        <!-- Check: Min 8 karakter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_schedule_block"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/checkLength"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_check_fail"
                android:gravity="center"
                android:text="✗"
                android:textColor="@color/dlg_check_fail_text"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/labelLength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Minimal 8 karakter"
                android:textColor="@color/dlg_text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Check: Huruf besar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_schedule_block"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/checkUppercase"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_check_fail"
                android:gravity="center"
                android:text="✗"
                android:textColor="@color/dlg_check_fail_text"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/labelUppercase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Minimal 1 huruf besar (A-Z)"
                android:textColor="@color/dlg_text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Check: Angka -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_schedule_block"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">
            <TextView
                android:id="@+id/checkDigit"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_check_fail"
                android:gravity="center"
                android:text="✗"
                android:textColor="@color/dlg_check_fail_text"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/labelDigit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Minimal 1 angka (0-9)"
                android:textColor="@color/dlg_text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp" android:background="@color/dlg_divider" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="16dp" android:paddingBottom="24dp">

        <Button android:id="@+id/btnOk"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_btn_blue"
            android:text="OK, Perbaiki Password"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" android:textStyle="bold"
            android:insetTop="0dp" android:insetBottom="0dp" />
    </LinearLayout>

</LinearLayout>

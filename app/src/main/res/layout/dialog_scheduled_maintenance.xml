<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_scheduled_maintenance.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:elevation="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header_yellow"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_circle_white"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="30sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maintenance Dijadwalkan"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="PENGUMUMAN"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Maintenance dijadwalkan. Pastikan pekerjaan Anda tersimpan sebelum dimulai."
            android:textColor="@color/dlg_text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.6"
            android:gravity="center" />

        <!-- Schedule Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_schedule_block"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="📅" android:textSize="14sp" android:gravity="center" />
                <TextView android:id="@+id/tvScheduleDate"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="-"
                    android:textColor="@color/dlg_text_secondary" android:textSize="13sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="🕐" android:textSize="14sp" android:gravity="center" />
                <TextView android:id="@+id/tvScheduleTime"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="-"
                    android:textColor="@color/dlg_text_secondary" android:textSize="13sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:visibility="gone">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="⏱️" android:textSize="14sp" android:gravity="center" />
                <TextView android:id="@+id/tvDuration"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/dlg_text_secondary" android:textSize="13sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_info_row_yellow"
                android:padding="8dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="⏳" android:textSize="14sp" android:gravity="center" />
                <TextView android:id="@+id/tvTimeUntil"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dimulai dalam..."
                    android:textColor="@color/dlg_orange_dark"
                    android:textSize="13sp" android:textStyle="bold"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp" android:background="@color/dlg_divider" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="16dp" android:paddingBottom="24dp">

        <Button android:id="@+id/btnOk"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_btn_yellow"
            android:text="Mengerti"
            android:textColor="#FF1A237E"
            android:textSize="14sp" android:textStyle="bold"
            android:insetTop="0dp" android:insetBottom="0dp" />
    </LinearLayout>

</LinearLayout>
